# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="SMS Pipeline"
APP_VERSION="1.0.0"
SECRET_KEY=change-me-to-a-random-64-char-string
ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=sms
POSTGRES_PASSWORD=sms_secret
POSTGRES_DB=sms_pipeline
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sms:sms_secret@localhost:5432/sms_pipeline
DATABASE_URL_SYNC=postgresql+psycopg2://sms:sms_secret@localhost:5432/sms_pipeline

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Frontend URLs ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Scraping ──────────────────────────────────────────────────────────────────
SELENIUM_HEADLESS=true
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
SCRAPE_MAX_RETRIES=3

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
